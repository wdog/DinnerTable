{
    "preset": "laravel",
    "rules": {
        "simplified_null_return": true,
        "braces": false,
        "array_indentation": true,
        "not_operator_with_space": true,
        "concat_space": true,
        "new_with_braces": {
            "anonymous_class": false,
            "named_class": false
        },
        "array_syntax": {
            "syntax": "short"
        },
        "binary_operator_spaces": {
            "default": "single_space",
            "operators": {
                "=>": "align"
            }
        },
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "length"
        }
    }
}
